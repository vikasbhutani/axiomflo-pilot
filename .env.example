# Copy this file to .env.local (for `npm run dev`) or .env.production (for a
# Cloud Run build) and fill in the values. See "Google sign-in setup" in README.md.
#
# Everything starting with VITE_ is built into the JavaScript that every visitor
# downloads, so only PUBLIC values belong here. Firebase web configuration is public
# client configuration. NEVER put an OAuth client secret, a service-account key or
# Firebase Admin SDK credentials in this file.
#
# Vite reads these when it builds the app: after changing them, restart `npm run dev`
# or rebuild/redeploy.

# Firebase web app configuration (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: set to "disabled" to hide "Explore the demo workspace" (sample data).
VITE_DEMO_MODE=

# Optional: published Terms of Service and Privacy Policy pages (https:// links).
# Until these are set, the sign-in pages show them as "setup required".
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Optional: the future AxiomFlo backend (https://). Leave empty until it exists;
# while empty, every signed-in person sees "Access pending".
VITE_API_BASE_URL=
