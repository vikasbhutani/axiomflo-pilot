server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Basic security headers for a static demo site.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Built JS/CSS files have content hashes in their names, so they can be cached for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # /api/* is forwarded to the AxiomFlo API (API_ORIGIN, e.g. https://axiomflo-api-xxxx.a.run.app),
    # so the browser talks to one address and no CORS is needed. The API itself checks the
    # Firebase sign-in on every request; this forwarding grants nothing.
    location /api/ {
        # Resolve the API's hostname at request time (Cloud Run addresses can change).
        resolver 169.254.169.254 8.8.8.8 valid=60s ipv6=off;
        set $api_origin "${API_ORIGIN}";
        proxy_pass $api_origin;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        client_max_body_size 16k;
        # The API sends its own security headers; drop them so the server-wide ones aren't doubled.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        error_page 502 503 504 = @api_unavailable;
    }

    # The assistant waits for Gemini, which can take longer than other API calls.
    location /api/assistant/ {
        resolver 169.254.169.254 8.8.8.8 valid=60s ipv6=off;
        set $api_origin "${API_ORIGIN}";
        proxy_pass $api_origin;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 100s;
        client_max_body_size 16k;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        error_page 502 503 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":{"code":"membership_unavailable","message":"The AxiomFlo API is not reachable right now."}}';
    }

    # Single-page app: send unknown paths (e.g. /usage, /settings) to index.html
    # so React Router can handle them. index.html itself is never cached.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
