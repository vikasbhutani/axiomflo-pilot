# Settings for the AxiomFlo API. Copy to .env.local for `npm run dev`.
# None of these are secrets. Never put a service-account key, private key or
# token in this file: locally the API uses your own Google sign-in
# (Application Default Credentials), and on Cloud Run it uses the service's
# runtime service account.

# The Firebase project whose sign-in tokens are accepted. Tokens issued for any
# other project are rejected.
FIREBASE_PROJECT_ID=axiomflo-pilot

# The one approved pilot company (the Firestore document ID under companies/).
# The browser can never choose this. Use the same ID you give the bootstrap script.
PILOT_COMPANY_ID=your-company-id

# Exact web addresses allowed to call the API from a browser, comma separated.
# Leave empty when the web app and API share one address (recommended).
# Wildcards (*) are refused.
ALLOWED_ORIGINS=http://localhost:5173

# Port to listen on. Cloud Run sets this itself; 8080 locally.
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info
