{
  "name": "axiomflo-api",
  "private": true,
  "version": "0.1.0",
  "description": "AxiomFlo API: verifies Firebase sign-in and checks company membership before any workspace access.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap": "tsx src/bootstrap/cli.ts",
    "add-viewer": "tsx src/viewer/cli.ts",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-axiomflo \"vitest run --config vitest.emulator.config.ts\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "firebase-tools": "^15.34.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
