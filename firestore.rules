rules_version = '2';

// AxiomFlo Firestore security rules.
//
// Browsers have NO direct access to Firestore. Everything (companies, teams,
// memberships, invitations, audit events) is read and written only by the AxiomFlo
// API on the server, which checks the caller's Firebase sign-in and membership on
// every request.
//
// The API uses the Firebase Admin SDK, which bypasses these rules. That is why the
// API's own checks, and the narrow IAM roles of its service account, are what protect
// the data; these rules only make sure nothing can go around the API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
